#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Register the Composer Autoloader
if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require __DIR__.'/vendor/autoload.php';
} else {
    // Graceful fallback for non-installed vendors
    fwrite(STDERR, "Error: Composer dependencies not installed. Please run 'composer install' first.\n");
    exit(1);
}

// Bootstrap Laravel and handle the command
$status = (require_once __DIR__.'/bootstrap/app.php')
    ->handleCommand(new Symfony\Component\Console\Input\ArgvInput, new Symfony\Component\Console\Output\ConsoleOutput);

exit($status);
