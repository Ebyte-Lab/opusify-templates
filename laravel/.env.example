APP_NAME="Laravel Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Application Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Supported: "sqlite", "mysql", "mariadb", "pgsql", "sqlsrv"
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session, Cache, and Queue Config
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12

# Cache and Cache Drivers
# Supported: "database", "file", "redis", "array", "null"
CACHE_STORE=database
CACHE_PREFIX=

# Queue Drivers
# Supported: "sync", "database", "redis", "sqs", "null"
QUEUE_CONNECTION=sync

# Redis Cache and Sessions config
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Mailpit/Local SMTP default)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum CORS config for SPA applications
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"
